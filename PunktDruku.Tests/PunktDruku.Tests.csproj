<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testy jednostkowe logiki aplikacji (obliczenia, walidacja, ViewModel).
    Pliki źródłowe są dołączane jako linki, dzięki czemu testy działają
    na zwykłym net8.0 bez emulatora i bez workloadu Android.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PunktDruku\Models\*.cs" Link="App\Models\%(Filename)%(Extension)" />
    <Compile Include="..\PunktDruku\Services\*.cs" Link="App\Services\%(Filename)%(Extension)" />
    <Compile Include="..\PunktDruku\ViewModels\*.cs" Link="App\ViewModels\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls.Core" Version="8.0.100" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
